{
  "name": "sinuca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jogo de sinuca 8 bolas com física realista em TypeScript",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sinuca/web",
    "build": "npm run build -w @sinuca/web",
    "build:single": "npm run build:single -w @sinuca/web",
    "preview": "npm run preview -w @sinuca/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:benchmark": "node scripts/ai-benchmark.mjs",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
